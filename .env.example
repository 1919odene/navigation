# Copy this file to .env for local development.
# In Railway, add these same variables in the Variables tab.

# Server port (Railway usually provides this automatically)
PORT=3000

# MongoDB connection string
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/grazing-nav?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/grazing-nav

# JWT secret used for auth tokens
JWT_SECRET=replace-with-a-strong-random-secret

# Admin panel secret used by the server
ADMIN_SECRET_KEY=replace-with-a-strong-admin-secret

# Africa's Talking SMS credentials
AT_API_KEY=replace-with-your-africas-talking-api-key
AT_USERNAME=sandbox
AT_SENDER_ID=NAVIGATE
